# Optional. If both are set (locally in .env or in Vercel → Settings → Environment Variables),
# the build writes them into config.js; otherwise web/config.js is used as-is.
# Only the anon/publishable key belongs here — never the service_role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
